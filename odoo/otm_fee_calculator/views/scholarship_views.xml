<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_otm_fee_scholarship_list" model="ir.ui.view">
        <field name="name">otm.fee.scholarship.list</field>
        <field name="model">otm.fee.scholarship</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="kind"/>
                <field name="percentage"/>
                <field name="apply_on"/>
            </list>
        </field>
    </record>

    <record id="view_otm_fee_scholarship_form" model="ir.ui.view">
        <field name="name">otm.fee.scholarship.form</field>
        <field name="model">otm.fee.scholarship</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group name="main">
                        <group name="main_left">
                            <field name="name"/>
                            <field name="kind"/>
                            <field name="percentage"/>
                            <field name="apply_on"/>
                        </group>
                        <group name="main_right">
                            <field name="course_ids" widget="many2many_tags"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group name="terms">
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_otm_fee_scholarship" model="ir.actions.act_window">
        <field name="name">Scholarships &amp; Discounts</field>
        <field name="res_model">otm.fee.scholarship</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
