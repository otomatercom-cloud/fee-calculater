<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_otm_fee_currency_list" model="ir.ui.view">
        <field name="name">otm.fee.currency.list</field>
        <field name="model">otm.fee.currency</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="symbol"/>
                <field name="auto_fetch"/>
                <field name="current_rate"/>
                <field name="logic_rate"/>
                <field name="rate_updated"/>
                <field name="rate_source"/>
                <button name="action_fetch_rate_button" type="object" string="Fetch Now" icon="fa-refresh"/>
            </list>
        </field>
    </record>

    <record id="action_otm_fee_currency" model="ir.actions.act_window">
        <field name="name">Currency Rates</field>
        <field name="res_model">otm.fee.currency</field>
        <field name="view_mode">list</field>
    </record>

    <record id="cron_otm_fee_fetch_rates" model="ir.cron">
        <field name="name">Fee Calculator: fetch current currency rates</field>
        <field name="model_id" ref="model_otm_fee_currency"/>
        <field name="state">code</field>
        <field name="code">model._cron_fetch_rates()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
</odoo>
