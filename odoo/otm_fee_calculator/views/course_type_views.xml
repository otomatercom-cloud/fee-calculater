<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_otm_fee_course_type_list" model="ir.ui.view">
        <field name="name">otm.fee.course.type.list</field>
        <field name="model">otm.fee.course.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="action_otm_fee_course_type" model="ir.actions.act_window">
        <field name="name">Course Types</field>
        <field name="res_model">otm.fee.course.type</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
