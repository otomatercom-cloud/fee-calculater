<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_fee_calculator" model="res.groups.privilege">
        <field name="name">Fee Calculator</field>
        <field name="category_id" ref="base.module_category_customizations"/>
    </record>

    <record id="group_fee_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_fee_calculator"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_fee_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_fee_calculator"/>
        <field name="implied_ids" eval="[(4, ref('group_fee_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
